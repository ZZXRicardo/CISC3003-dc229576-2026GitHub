* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Segoe UI', sans-serif; line-height: 1.6; background-color: #f4f7f6; color: #333; }
header { background-color: #2c3e50; padding: 1rem 0; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
nav ul { list-style: none; display: flex; justify-content: center; gap: 2rem; }
nav a { color: #ffffff; text-decoration: none; font-size: 1.1rem; font-weight: 500; transition: color 0.3s ease; }
nav a:hover { color: #3498db; }
footer { background-color: #2c3e50; color: #ffffff; text-align: center; padding: 1.5rem 0; margin-top: 4rem; }

main { max-width: 900px; margin: 3rem auto; padding: 0 1rem; }
main > h1 { text-align: center; color: #2c3e50; font-size: 2.5rem; margin-bottom: 2rem; }
.project-demo { background-color: #ffffff; padding: 2.5rem; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 3rem; border-left: 5px solid #3498db; }
.project-demo h2 { color: #2c3e50; font-size: 1.8rem; margin-bottom: 0.5rem; }
.project-demo h3 { color: #3498db; margin-top: 1.5rem; margin-bottom: 0.5rem; }
.project-img { width: 100%; max-width: 800px; height: auto; border-radius: 8px; margin: 1.5rem 0; box-shadow: 0 4px 8px rgba(0,0,0,0.1); display: block; }
.project-demo p { margin-bottom: 1rem; color: #555; }
.project-demo ul { margin-left: 1.5rem; margin-bottom: 1rem; color: #555; }
.project-demo li { margin-bottom: 0.5rem; }